{% extends 'base.html.twig' %}

{% block title %}À propos de nous{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/About.css') }}">
{% endblock %}

{% block body %}
<div class="about-container">
    <div class="about-header">
        <h1>À propos de nous</h1>
        <p>Découvrez notre mission, notre histoire, notre équipe et nos valeurs.</p>
    </div>

    <div class="about-section">
        <h2>Notre Mission</h2>
        <p>
            Nous visons à offrir des solutions performantes et accessibles afin d'aider nos utilisateurs à
            réaliser leurs projets avec succès. Notre approche est centrée sur l’humain et l’innovation.
        </p>
    </div>

    <div class="about-section">
        <h2>Notre Histoire</h2>
        <p>
            Depuis notre création en 2025, nous évoluons constamment pour proposer des outils modernes et fiables.
            Chaque année marque une nouvelle étape dans notre développement.
        </p>
    </div>

    <div class="about-section">
        <h2>Notre Équipe</h2>
        <p>
            Notre équipe est composée de développeurs, designers et créatifs passionnés qui travaillent ensemble
            pour offrir des projets de qualité.
        </p>
    </div>

    <div class="about-section">
        <h2>Nos Valeurs</h2>
        <ul>
            <li><strong>Innovation :</strong> Rechercher de nouvelles idées et améliorer ce qui existe.</li>
            <li><strong>Qualité :</strong> Proposer des solutions performantes et robustes.</li>
            <li><strong>Transparence :</strong> Communiquer de manière claire et honnête.</li>
            <li><strong>Engagement :</strong> Être présent pour nos utilisateurs.</li>
        </ul>
    </div>
</div>
{% endblock %}
